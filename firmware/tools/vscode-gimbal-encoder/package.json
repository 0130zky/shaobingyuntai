{
  "name": "robot-template-gimbal-encoder",
  "displayName": "robot_template 云台编码器",
  "description": "VS Code内显示折叠与Pitch两台DM4310的原始编码值、角度和反馈状态。",
  "version": "0.2.0",
  "publisher": "local-robot-template",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "robot_templateGimbal.open",
        "title": "robot_template: 打开云台编码器"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "license": "UNLICENSED"
}
